{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ssh-test-env": {
      "type": "local",
      "command": [
        "./target/release/ssh-mcp",
        "--host=127.0.0.1",
        "--port=2222",
        "--user=test",
        "--password=secret",
        "--timeout=60000",
        "--log-file=logs/ssh-mcp.log",
        "--log-format=json",
        "--log-rotation=daily"
      ],
      "enabled": true
    }
  }
}

